{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {"const": "prim.workbook"},
    "version": {"const": "0.1.0"},
    "workbook_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "title": {"type": "string", "minLength": 1, "maxLength": 256},
    "periods": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 64}, "maxItems": 1000},
    "worksheets": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "properties": {
          "n": {"type": "integer", "minimum": 1, "maximum": 10000},
          "id": {"type": "string", "minLength": 1, "maxLength": 128},
          "role": {"enum": ["expected", "actuals", "other"]},
          "pack": {"type": "string", "minLength": 1, "maxLength": 256},
          "title": {"type": "string", "minLength": 1, "maxLength": 256}
        },
        "required": ["n", "id", "role", "pack", "title"],
        "additionalProperties": true
      }
    }
  },
  "required": ["format", "version", "workbook_id", "title", "periods", "worksheets"],
  "additionalProperties": true
}
