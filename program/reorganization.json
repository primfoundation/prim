{
  "format": "prim-foundation-reorganization",
  "version": 1,
  "as_of": "2026-09-07",
  "target_active_repositories": [
    "primfoundation/.github",
    "primfoundation/prim",
    "primfoundation/prims-hub",
    "primfoundation/prims-desktop",
    "primfoundation/primboard",
    "primfoundation/prims-browsers"
  ],
  "principles": [
    "repositories map to independent standards/product/release responsibility, not routes or Prim types",
    "profile identity is independent of repository location",
    "user Prim instances remain user-owned and private by default",
    "archive only after successor, compatibility, tests, rollback and real-use proof",
    "brand, repository, public route and runtime security identities are distinct rename layers",
    "no force-push or history deletion as cleanup"
  ],
  "repositories": [
    {
      "source": "primfoundation/.github",
      "target": "primfoundation/.github",
      "class": "organization-policy",
      "lifecycle": "active",
      "action": "keep-and-strengthen",
      "notes": "Own only organization-wide defaults, templates, shared policy and genuinely reusable CI."
    },
    {
      "source": "primfoundation/prim",
      "target": "primfoundation/prim",
      "class": "standards",
      "lifecycle": "active",
      "action": "keep-and-consolidate-definitions",
      "notes": "Category spec, portable profiles, compatibility, conformance, publication contracts and program record."
    },
    {
      "source": "primfoundation/prim-web",
      "target": "primfoundation/prims-hub",
      "class": "public-platform",
      "lifecycle": "migrating",
      "action": "audit-then-rename-or-import-history",
      "open_prs": [
        1
      ],
      "archive_gate": [
        "history and private-asset audit",
        "Cloudflare Worker preview passes",
        "website/API/MCP cutover passes",
        "old Pages/Railway rollback preserved"
      ],
      "merged_preview_pr": 5
    },
    {
      "source": "primfoundation/prim-registry",
      "target": "primfoundation/prims-hub",
      "class": "route-service",
      "lifecycle": "migrating",
      "action": "absorb-runtime-and-tests",
      "open_prs": [
        1
      ],
      "archive_gate": [
        "registry.prims.sh compatibility route proven",
        "current HTTP clients inventoried",
        "tests and release evidence moved",
        "rollback window complete"
      ]
    },
    {
      "source": "primfoundation/prim.workbook",
      "target": "primfoundation/prim:profiles/workbook",
      "class": "profile-incubator",
      "lifecycle": "migrating",
      "action": "migrate-definition-and-classify-viewer",
      "open_prs": [
        1
      ],
      "risk": "repository history may contain private/customer material; public scrub must be reviewed before visibility or migration",
      "archive_gate": [
        "privacy/history audit",
        "profile semantics fixtures and validators moved",
        "viewer assigned to Hub/Desktop/other appropriate surface",
        "old consumers pass"
      ],
      "definition_import": {
        "source_commit": "8e997f0e349d788c56722ea8bd0c3d0afbdb99e5",
        "foundation_pr": 10,
        "status": "sanitized_profile_merged_viewer_and_consumer_gates_open"
      }
    },
    {
      "source": "primfoundation/prims-desktop",
      "target": "primfoundation/prims-desktop",
      "class": "signed-desktop-product",
      "lifecycle": "active",
      "action": "keep-and-refactor-generic-host",
      "open_prs": [
        2,
        3,
        4,
        6
      ],
      "notes": "Preserve Mac proof gates; reconcile existing connector, XPC/Messages, logging and person-resolution work before broad refactor.",
      "source_gate": "../prim-sim is required but authoritative source provenance is unavailable; proof preflight PR #7 merged."
    },
    {
      "source": "primfoundation/prims-browsers",
      "target": "primfoundation/prims-browsers",
      "class": "browser-sandbox-product",
      "lifecycle": "active",
      "action": "keep-and-absorb-cloud-apps"
    },
    {
      "source": "primfoundation/browsers-prims-sh",
      "target": "primfoundation/prims-browsers:cloud/apps/gateway",
      "class": "product-route-service",
      "lifecycle": "migrating",
      "action": "merge-into-product",
      "archive_gate": [
        "browsers.prims.sh live behavior unchanged",
        "container registry and machine redirects tested",
        "session/auth boundary tested",
        "rollback complete"
      ],
      "source_import_status": "merged in successor; deployment/real-account/route gates open"
    },
    {
      "source": "primfoundation/logins-prims-sh",
      "target": "primfoundation/prims-browsers:cloud/apps/login",
      "class": "product-route-service",
      "lifecycle": "migrating",
      "action": "merge-into-product-unless-identity-scope-changes",
      "archive_gate": [
        "Apple login callback tested",
        "shared cookie/domain behavior tested",
        "secrets recreated in target environment without copying values through git",
        "rollback complete"
      ],
      "source_import_status": "merged in successor; deployment/real-account/route gates open"
    },
    {
      "source": "primfoundation/prims-paste-desktop",
      "target": "primfoundation/primboard",
      "class": "signed-desktop-product",
      "lifecycle": "migrating",
      "action": "stabilize-then-rename-repository",
      "observed_commit": "5be76f05e8845c9bb0f3c1778d00e0971d82bb45",
      "locked_compatibility_identities": [
        "CFBundleIdentifier=sh.prims.paste",
        "executable=PrimsPaste",
        "cli=prims-paste",
        "store=~/.prims-paste/",
        "keychain_service=sh.prims.paste",
        "existing serialized notebook/sticky IDs"
      ],
      "refactor_priorities": [
        "encrypt sensitive notebook index metadata",
        "interprocess app/CLI locking and stale-write protection",
        "crash-consistent atomic replacement",
        "versioned store migrations and rollback",
        "backup/export/restore and lost-key UX",
        "explicit Touch ID versus CLI/Keychain threat model",
        "remove product bugs/features seeding from normal user notebooks",
        "generic Convert to Prim using pinned Foundation Library definition",
        "real Mac TCC/signing/store regression matrix",
        "accessibility and large-board performance"
      ],
      "archive_gate": "not-applicable; repository is renamed successor, old GitHub slug should redirect",
      "merged_stabilization_pr": 1
    }
  ],
